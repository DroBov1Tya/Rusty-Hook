# rusty_hook config. Copy to .env and fill secrets.

# --- app ---
APP_PORT=8080
# 0.0.0.0 = reachable from network; 127.0.0.1 = local only
APP_HOST=0.0.0.0
# login = sign-in required (default): admin key and/or SSO below
# open  = no login at all (trusted networks only; set PUBLIC_HOSTS)
AUTH_MODE=login
# Panel key, min 16 chars. Empty = key login disabled. Generate: openssl rand -hex 24
ADMIN_KEY=
# true behind HTTPS (__Host- cookie). false only for plain http on LAN/localhost.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
# Panel host allowlist against DNS rebinding, e.g. hooks.example.com,localhost
# Empty = any host (fine with AUTH_MODE=key; strongly advised with open mode).
PUBLIC_HOSTS=
# Trust rightmost X-Forwarded-For (only behind your own reverse proxy).
TRUST_FORWARDED=false
RUST_LOG=info

# --- limits ---
MAX_BODY_BYTES=1048576
MAX_REQUESTS_PER_ENDPOINT=500
MAX_ENDPOINTS=100
MAX_CONNECTIONS=1024
# In-flight hooks (bounds memory: HOOK_CONCURRENCY * MAX_BODY_BYTES)
HOOK_CONCURRENCY=64
# Per client IP
HOOK_RATE_PER_MINUTE=600
RETENTION_DAYS=7
# Per pool (panel + hooks = 2 pools)
PG_MAX_CONNECTIONS=16

# --- postgres ---
POSTGRES_USER=rusty_hook
POSTGRES_DB=rusty_hook
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- optional SSO: any OIDC provider (Keycloak, Authentik, Google, Entra, GitLab...) ---
# Register a confidential client with redirect URI = OIDC_REDIRECT_URL, scopes: openid email profile.
# Empty OIDC_ISSUER_URL = SSO disabled.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the IdP registration exactly, e.g. https://hooks.example.com/api/oidc/callback
OIDC_REDIRECT_URL=
# Deny by default: at least one list is required. Comma separated, exact match.
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_DOMAINS=
# Only for local test IdPs over plain http.
OIDC_ALLOW_HTTP=false
